# Normalise line endings in the repository regardless of who commits from where.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or PowerShell can misparse them.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never touch binaries.
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary

# Keep generated lockfiles out of diffs and language statistics.
package-lock.json  -diff linguist-generated=true
